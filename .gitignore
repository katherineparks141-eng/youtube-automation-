# Secrets — never commit
.env
*.env
*api_key*

# Generated media — large binaries, regenerate rather than version
*.mp4
*.wav
*.mp3
*.png
*.jpg
*.jpeg

# Scratch narration text pulled from scripts during production — not a source file
narration_*.txt

# Voice models — large, re-downloaded by pipeline/setup_tts_voices.sh
*.onnx
*.onnx.json

# Python / Node cruft
__pycache__/
*.pyc
node_modules/
.DS_Store
